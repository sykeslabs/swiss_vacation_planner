# Copy to .env (never commit .env). All values are optional; each feature degrades on its own.

# You.com — Swiss holiday check (server-side only)
YDC_API_KEY=

# OpenRouter — optional travel ideas (server-side only, from M7)
OPENROUTER_API_KEY=

# "Über Adam" help modal. Public values, shown to every visitor. Missing → element hidden.
ADAM_CONTACT_EMAIL=
ADAM_WEBSITE_URL=
ADAM_DONATE_URL=
ADAM_DONATE_LABEL=
